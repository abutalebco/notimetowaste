{
  "name": "NoTimeToWasteVS",
  "displayName": "NoTimeToWaste",
  "icon": "public/images/logo.png",
  "description": "A gamified tasbih / tally counter for your adhkar, right inside VS Code.",
  "publisher": "abutalebco",
  "repository": {
    "type": "git",
    "url": "https://github.com/abutalebco/notimetowaste.git"
  },
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "tasbih",
    "zikr",
    "dhikr",
    "adhkar",
    "islam",
    "counter",
    "tally"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "browser": "./dist/web/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "NoTimeToWaste",
          "title": "NoTimeToWaste",
          "icon": "public/images/seen-letter-white.png"
        }
      ]
    },
    "views": {
      "notimetowaste": [
        {
          "type": "webview",
          "id": "NoTimeToWaste.counter",
          "name": "Tasbih"
        }
      ]
    },
    "commands": [
      {
        "command": "NoTimeToWaste.increment",
        "title": "Count (+1)",
        "category": "NoTimeToWaste"
      },
      {
        "command": "NoTimeToWaste.reset",
        "title": "Reset Round",
        "category": "NoTimeToWaste",
        "icon": "$(debug-restart)"
      },
      {
        "command": "NoTimeToWaste.configureShortcut",
        "title": "Customize Count Shortcut",
        "category": "NoTimeToWaste",
        "icon": "$(keyboard)"
      },
      {
        "command": "NoTimeToWaste.openSettings",
        "title": "Open Settings",
        "category": "NoTimeToWaste",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "NoTimeToWaste.reset",
          "when": "view == NoTimeToWaste.counter",
          "group": "navigation"
        },
        {
          "command": "NoTimeToWaste.openSettings",
          "when": "view == NoTimeToWaste.counter",
          "group": "navigation"
        },
        {
          "command": "NoTimeToWaste.configureShortcut",
          "when": "view == NoTimeToWaste.counter",
          "group": "settings"
        }
      ]
    },
    "keybindings": [
      {
        "command": "NoTimeToWaste.increment",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "config.NoTimeToWaste.shortcut == 'ctrl+alt+t'"
      },
      {
        "command": "NoTimeToWaste.increment",
        "key": "ctrl+alt+z",
        "mac": "cmd+alt+z",
        "when": "config.NoTimeToWaste.shortcut == 'ctrl+alt+z'"
      },
      {
        "command": "NoTimeToWaste.increment",
        "key": "ctrl+alt+space",
        "mac": "cmd+alt+space",
        "when": "config.NoTimeToWaste.shortcut == 'ctrl+alt+space'"
      },
      {
        "command": "NoTimeToWaste.increment",
        "key": "ctrl+shift+alt+t",
        "mac": "cmd+shift+alt+t",
        "when": "config.NoTimeToWaste.shortcut == 'ctrl+shift+alt+t'"
      },
      {
        "command": "NoTimeToWaste.increment",
        "key": "alt+=",
        "when": "config.NoTimeToWaste.shortcut == 'alt+='"
      }
    ],
    "configuration": {
      "title": "NoTimeToWaste",
      "properties": {
        "NoTimeToWaste.shortcut": {
          "type": "string",
          "default": "ctrl+alt+t",
          "enum": [
            "ctrl+alt+t",
            "ctrl+alt+z",
            "ctrl+alt+space",
            "ctrl+shift+alt+t",
            "alt+=",
            "custom"
          ],
          "enumItemLabels": [
            "Ctrl+Alt+T  (⌘⌥T on Mac)",
            "Ctrl+Alt+Z  (⌘⌥Z on Mac)",
            "Ctrl+Alt+Space  (⌘⌥Space on Mac)",
            "Ctrl+Shift+Alt+T  (⌘⇧⌥T on Mac)",
            "Alt+=",
            "Custom (set in Keyboard Shortcuts)"
          ],
          "markdownDescription": "Keyboard shortcut that counts **+1**. Pick a preset, or choose *Custom* and assign any key in [Keyboard Shortcuts](command:notimetowaste.configureShortcut)."
        },
        "NoTimeToWaste.language": {
          "type": "string",
          "default": "arabic",
          "enum": [
            "arabic",
            "arabic-transliteration",
            "arabic-english",
            "english"
          ],
          "enumItemLabels": [
            "العربية فقط (Arabic only)",
            "Arabic + transliteration",
            "Arabic + English meaning",
            "Transliteration + English meaning (no Arabic)"
          ],
          "markdownDescription": "How adhkar are displayed in the dropdown, sidebar and status bar. Default is Arabic only."
        },
        "NoTimeToWaste.dailyGoal": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Daily goal for the **Today** progress bar. `0` = automatic: your own daily average (starts at 100 until there is history)."
        },
        "NoTimeToWaste.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the tasbih counter in the status bar."
        },
        "NoTimeToWaste.notifications": {
          "type": "boolean",
          "default": true,
          "description": "Show VS Code notifications for level-ups and reaching the daily goal (the sidebar always celebrates)."
        }
      }
    }
  },
  "scripts": {
    "test": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. --extensionTestsPath=dist/web/test/suite/index.js",
    "pretest": "npm run compile-web",
    "vscode:prepublish": "npm run package-web",
    "compile-web": "webpack",
    "watch-web": "webpack --watch",
    "package-web": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src",
    "run-in-browser": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. ."
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/assert": "^1.5.11",
    "eslint": "^10.5.0",
    "typescript-eslint": "^8.61.1",
    "mocha": "^11.7.6",
    "typescript": "^6.0.3",
    "@vscode/test-web": "^0.0.81",
    "ts-loader": "^9.6.2",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "@types/webpack-env": "^1.18.8",
    "assert": "^2.1.0",
    "process": "^0.11.10"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
